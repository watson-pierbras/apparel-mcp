# SanMar SOAP API credentials
SANMAR_CUSTOMER_NUMBER=
SANMAR_USERNAME=
SANMAR_PASSWORD=

# S&S Activewear REST API credentials
SS_ACCOUNT_NUMBER=
SS_API_KEY=

# Database path (relative to project root).
# On Railway this is overridden to /app/data/apparel.db (mounted Volume).
DB_PATH=./data/apparel.db

# Bearer token that clients (Perplexity, etc.) must send as
#   Authorization: Bearer <MCP_API_KEY>
# Generate a strong secret, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave this BLANK for local stdio use with Claude Desktop.
# REQUIRED when exposing the server publicly.
MCP_API_KEY=

# Port the HTTP transport binds to. Railway injects $PORT automatically,
# so you normally do not need to set this on Railway.
PORT=8000
